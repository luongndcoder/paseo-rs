{
  "note": "Each scenario runs on a fresh VersionedCollection with getId=item.id and default JSON.stringify fingerprint.",
  "scenarios": [
    {
      "name": "replace_and_fingerprint",
      "description": "replace bumps only when JSON.stringify differs; remove of unknown id is a no-op.",
      "maxTombstones": 5000,
      "ops": [
        {
          "op": "replace",
          "value": {
            "id": "a",
            "v": 1
          },
          "result": {
            "kind": "upsert",
            "seq": 1,
            "value": {
              "id": "a",
              "v": 1
            }
          }
        },
        {
          "op": "replace",
          "value": {
            "id": "a",
            "v": 1
          },
          "result": null
        },
        {
          "op": "replace",
          "value": {
            "id": "a",
            "v": 2
          },
          "result": {
            "kind": "upsert",
            "seq": 2,
            "value": {
              "id": "a",
              "v": 2
            }
          }
        },
        {
          "op": "remove",
          "id": "zzz",
          "result": null
        },
        {
          "op": "remove",
          "id": "a",
          "result": {
            "kind": "remove",
            "seq": 3,
            "id": "a"
          }
        },
        {
          "op": "remove",
          "id": "a",
          "result": null
        },
        {
          "op": "replace",
          "value": {
            "id": "a",
            "v": 2
          },
          "result": {
            "kind": "upsert",
            "seq": 4,
            "value": {
              "id": "a",
              "v": 2
            }
          }
        },
        {
          "op": "sequenceFor",
          "id": "a",
          "result": 4
        },
        {
          "op": "headSeq",
          "result": 4
        }
      ]
    },
